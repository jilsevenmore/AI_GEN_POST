# AI Gen Post - Environment Configuration
# Copy this file and adjust values as needed

# App
APP_NAME="AI Blog & Social Post Generator"
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gen_post"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Auth
SECRET_KEY="dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Password Reset) - Free mailer compatible
# For development (no SMTP): leave SMTP_HOST empty, codes are logged to console + reset_codes.log
# For production: configure SMTP with any free service (Ethereal.email, Mailtrap, SendGrid, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="noreply@aigenpost.local"
SMTP_FROM_NAME="AI Gen Post"
EMAIL_RESET_CODE_EXPIRE_MINUTES=15

# OpenRouter (Free models)
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Buffer
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# LangSmith Tracing
# Get your API key from https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="ai-gen-post"
LANGSMITH_TRACING=true

# Logging (structured JSON; set LOG_JSON=false for plain text)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_JSON=true
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=5
