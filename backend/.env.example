# App
APP_NAME="AI Blog & Social Post Generator"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gen_post"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL="redis://localhost:6379/0"

# Auth
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenRouter (Free models)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Free models list (comma-separated)
OPENROUTER_FREE_MODELS="meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free"
OPENROUTER_FREE_ROUTER="openrouter/free"
OPENROUTER_DAILY_LIMIT=50
OPENROUTER_RATE_LIMIT_RPM=20

# OpenAI (Fallback / image generation)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_FALLBACK_ENABLED=True

# Hugging Face (Inference Providers / Hub) - for free models
HF_TOKEN=""
HF_BASE_URL="https://router.huggingface.co/v1"
HF_PROMPT_MODEL="MiniMaxAI/MiniMax-M2.7"

# MiniMax prompt enhancement (via Hugging Face router by default)
MINIMAX_API_KEY=""  # Optional override; if empty, HF_TOKEN is used for HF router
MINIMAX_BASE_URL="https://router.huggingface.co/v1"
MINIMAX_MODEL="MiniMaxAI/MiniMax-M2.7"
MINIMAX_PROMPT_ENHANCE_ENABLED=True

# Ollama (local, free prompt enhancement) - recommended if HF hosted models are unavailable
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL=""  # e.g. qwen2.5:3b-instruct, llama3.2:3b, phi3.5
OLLAMA_PROMPT_ENHANCE_ENABLED=False

# GPT Image 2.5 Sunburst
SUNBURST_API_KEY=""
SUNBURST_BASE_URL="https://api.openai.com/v1"
SUNBURST_MODEL="gpt-image-2.5-sunburst"

# Embeddings (semantic search, Hugging Face sentence-transformers)
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"
EMBEDDING_DIMENSIONS=768
EMBEDDING_DEVICE="cpu"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="ai_gen_post"
CLOUDINARY_FOLDER_LIBRARY="library"
CLOUDINARY_FOLDER_PUBLISHED="published"
CLOUDINARY_FOLDER_DRAFTS="drafts"
CLOUDINARY_CREDITS_ALERT_THRESHOLD=0.7

# Buffer
BUFFER_CLIENT_ID=""
BUFFER_CLIENT_SECRET=""
# Buffer REQUIRES https:// for redirect URIs. Use ngrok for local dev:
BUFFER_REDIRECT_URI="https://your-ngrok-url.ngrok-free.app/auth/buffer/callback"
BUFFER_API_BASE="https://api.bufferapp.com/1"
BUFFER_RATE_LIMIT_RPM=100

# LangSmith
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ai-gen-post"
LANGSMITH_TRACING=True

# Quotas
DAILY_FREE_REQUESTS_PER_USER=12
DAILY_SPEND_CAP_USD=10.0
MAX_REGENERATIONS_PER_JOB=3

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Feature flags
ENABLE_IMAGE_LIBRARY=True
ENABLE_BRAND_KIT=True
ENABLE_BUFFER_PUBLISHING=True
ENABLE_FREE_MODELS_FIRST=True