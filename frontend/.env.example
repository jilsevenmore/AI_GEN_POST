# Frontend (Vite) environment variables
# Copy to .env and adjust for your environment.

# API base URL (optional). If omitted, the app uses relative /api paths (dev proxy in vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public site URL used for canonical/OG defaults in some deployments
VITE_SITE_URL=https://evenmoreinfotech.com

# Optional absolute OG image URL override (defaults to ${VITE_SITE_URL}/og-default.svg)
# VITE_OG_IMAGE_URL=https://evenmoreinfotech.com/og-default.svg

# Social profile links shown on the landing page footer/header
VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/evenmore-infotech
VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/evenmoreinfotech
VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/evenmoreinfotech

# Advertising pixels (optional)
VITE_META_PIXEL_ID=
VITE_GOOGLE_MEASUREMENT_ID=